# Variáveis de ambiente da Task Manager API (valores de exemplo, não use em produção).
# A aplicação carrega automaticamente um arquivo `.env` na raiz do projeto:
# copie este arquivo para `.env` e ajuste os valores, ou exporte as variáveis no shell.

# Chave de assinatura (tokens de login). Se ausente, um valor efêmero é gerado a cada boot.
SECRET_KEY=troque-por-um-valor-aleatorio-longo

# Banco de dados (SQLite relativo é criado em instance/)
DATABASE_URL=sqlite:///tasks.db

# Servidor: use HOST=0.0.0.0 apenas quando precisar expor a API na rede (ex.: containers)
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false

# Origens liberadas no CORS, separadas por vírgula.
# Default: http://localhost:3000,http://127.0.0.1:3000 — use * apenas em desenvolvimento, para liberar todas.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LOG_LEVEL=INFO
