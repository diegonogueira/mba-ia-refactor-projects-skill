# Copy to .env (never commit it) or export these variables before starting the app.

# Signing key for tokens. Required in production; a random ephemeral value is generated when missing.
SECRET_KEY=change-me-to-a-long-random-value

# Debug mode (interactive debugger + reloader). Keep false outside local development.
FLASK_DEBUG=false

# Bind address and port. Use HOST=0.0.0.0 only when the API must be reachable from other machines.
HOST=127.0.0.1
PORT=5000

# SQLAlchemy URL. Relative SQLite paths are created inside the Flask instance/ folder.
DATABASE_URL=sqlite:///tasks.db

# Comma-separated list of allowed CORS origins ("*" allows any origin).
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO
