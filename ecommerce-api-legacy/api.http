@baseUrl = http://localhost:3000
@adminToken = troque-por-um-token-aleatorio

### Checkout - sucesso
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Guilherme",
  "eml": "gui@fullcycle.com.br",
  "pwd": "senhaforte",
  "c_id": 2,
  "card": "4111222233334444"
}

### Checkout - pagamento recusado
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "João",
  "eml": "joao@teste.com",
  "pwd": "123",
  "c_id": 1,
  "card": "5111222233334444"
}

### Checkout - matrícula duplicada (400 depois do primeiro checkout com os mesmos dados)
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Guilherme",
  "eml": "gui@fullcycle.com.br",
  "pwd": "senhaforte",
  "c_id": 2,
  "card": "4111222233334444"
}

### Relatório financeiro administrativo
# Requer ADMIN_ENDPOINTS_ENABLED=true e ADMIN_TOKEN definidos no servidor; sem isso, 403.
GET {{baseUrl}}/api/admin/financial-report
X-Admin-Token: {{adminToken}}

### Deletar usuário
DELETE {{baseUrl}}/api/users/1
X-Admin-Token: {{adminToken}}
