# Variáveis de ambiente da LMS API.
# Nada carrega este arquivo automaticamente: exporte as variáveis no shell
# (ex.: `export ADMIN_TOKEN=...`) antes de rodar `npm start`.

# Porta HTTP (padrão: 3000)
PORT=3000

# Interface de rede (padrão: 127.0.0.1; use 0.0.0.0 em containers)
HOST=127.0.0.1

# Banco SQLite (padrão: :memory:, recriado e populado a cada boot)
DATABASE_PATH=:memory:

# Token exigido no header X-Admin-Token de GET /api/admin/financial-report e DELETE /api/users/:id.
# Sem valor, essas rotas continuam públicas (comportamento original).
ADMIN_TOKEN=troque-por-um-token-aleatorio

# Nível de log: error, warn, info ou debug (padrão: info)
LOG_LEVEL=info
