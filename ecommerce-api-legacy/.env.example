# Copie para .env (ignorado pelo git) ou exporte as variáveis antes de `npm start`.
PORT=3000
# ':memory:' recria e popula o banco a cada boot; use um caminho de arquivo para persistir.
DATABASE_PATH=:memory:
# Chave do gateway de pagamento (o gateway atual é simulado).
PAYMENT_GATEWAY_KEY=pk_test_placeholder
# Quando definido, GET /api/admin/financial-report e DELETE /api/users/:id exigem o header X-Admin-Token.
ADMIN_TOKEN=
# error | warn | info | debug
LOG_LEVEL=info
