# Variáveis de ambiente da API da Loja (valores fictícios).
# Nada carrega este arquivo automaticamente: exporte as variáveis no shell
# (ex.: `export SECRET_KEY=...`) ou configure-as no ambiente de execução.

# Chave de assinatura do Flask. Sem ela, um valor aleatório efêmero é gerado a cada boot.
SECRET_KEY=troque-por-um-valor-aleatorio-longo

# Servidor
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
APP_ENV=producao

# Banco SQLite e dados de exemplo (produtos e usuários de demonstração no primeiro boot)
DATABASE_PATH=loja.db
SEED_DATABASE=true

# Origens permitidas no CORS, separadas por vírgula ("*" libera todas)
CORS_ORIGINS=*

# Endpoints /admin/* ficam desabilitados por padrão; quando habilitados exigem o header X-Admin-Token
ADMIN_ENDPOINTS_ENABLED=false
ADMIN_TOKEN=troque-por-um-token-aleatorio
