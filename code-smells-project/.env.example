# Variáveis de ambiente da API da Loja (valores fictícios).
# Nada carrega este arquivo automaticamente: exporte as variáveis no shell
# (ex.: `export SECRET_KEY=...`) ou configure-as no ambiente de execução.

# Chave que assina os tokens do /login. Sem ela, um valor aleatório efêmero é gerado a cada boot
# (os tokens deixam de valer quando o servidor reinicia).
SECRET_KEY=troque-por-um-valor-aleatorio-longo
# Validade do token de login, em segundos (padrão: 8 horas)
TOKEN_MAX_AGE=28800

# Servidor
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
APP_ENV=producao

# Nível dos logs da aplicação (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Banco SQLite e dados de exemplo (produtos e usuários de demonstração no primeiro boot)
DATABASE_PATH=loja.db
SEED_DATABASE=true
# Senha dos usuários de demonstração. Se ficar vazia, uma senha aleatória é sorteada
# no primeiro boot e registrada no log uma única vez — não há senha padrão no código.
SEED_PASSWORD=

# Origens permitidas no CORS, separadas por vírgula. O padrão libera só a própria
# aplicação (http://HOST:PORT); use "*" apenas em desenvolvimento.
CORS_ORIGINS=http://127.0.0.1:5000

# Endpoints /admin/* ficam desabilitados por padrão; quando habilitados exigem o header X-Admin-Token
ADMIN_ENDPOINTS_ENABLED=false
ADMIN_TOKEN=troque-por-um-token-aleatorio
