# Exporte estas variáveis no shell (a aplicação não carrega .env automaticamente).
# Valores fictícios — nunca versione um .env com segredos reais.
SECRET_KEY=troque-por-um-valor-aleatorio-longo
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000
DATABASE_PATH=loja.db
# Cria produtos e contas de demonstração quando o banco está vazio (desligue em produção)
SEED_DATABASE=true
# Lista separada por vírgula, ex.: https://loja.exemplo.com,https://admin.exemplo.com
CORS_ORIGINS=*
APP_ENV=producao
# Endpoints /admin/* ficam desabilitados (403) a menos que as duas variáveis abaixo estejam definidas
ADMIN_ENDPOINTS_ENABLED=false
ADMIN_TOKEN=troque-por-um-token-longo
LOG_LEVEL=INFO
